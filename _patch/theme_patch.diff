+  var aLight = new THREE.AmbientLight(0xffffff, 0.5);
+  scene.add(aLight);
+  var dLight = new THREE.DirectionalLight(0xffd700, 1.5);
+  dLight.position.set(3, 5, 5);
+  scene.add(dLight);
+  var pLight = new THREE.PointLight(0x88ffaa, 0.8, 10);
+  pLight.position.set(-3, -2, 2);
+  scene.add(pLight);
+
+  var frame;
+  function animate() {
+    frame = requestAnimationFrame(animate);
+    var t = Date.now() * 0.001;
+    outer.rotation.y = t * 0.4;
+    outer.rotation.x = Math.sin(t * 0.5) * 0.15;
+    inner.rotation.y = -t * 0.6;
+    goldRing.rotation.y = t * 0.3;
+    renderer.render(scene, camera);
+  }
+  animate();
+  container._cleanup = function() { cancelAnimationFrame(frame); renderer.dispose(); };
+}
+
+function createMedievalHelmet(containerId) {
